{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studypilot",
  "compatibility_date": "2026-11-06",
  "pages_build_output_dir": ".",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studypilot-db",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE"
    }
  ]
}
